// Afro Egypt — Factory Workforce
// Prisma schema — MySQL. Mirrors src/lib/types.ts plus production additions:
//   - soft delete (deletedAt) on Employee / Department / Shift
//   - Device + biometric-punch fields on AttendanceLog (ZKTeco ingestion)
//   - User table for real authentication (Phase 6)
// Money is stored as whole EGP (Int) to match the pure calculation engines,
// which always round to the nearest pound.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  hr
  supervisor
  employee
  staff
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
}

enum EmployeeStatus {
  active
  on_leave
  terminated
}

enum SalaryType {
  monthly
  daily
}

enum MilitaryStatus {
  completed // أدى الخدمة
  exempted // إعفاء
  postponed // مؤجل
  not_applicable // لا ينطبق (إناث / خارج السن)
}

enum PunchType {
  in
  out
}

enum PunchSource {
  simulated
  manual_correction
  biometric
}

enum AttendanceStatus {
  present
  late
  absent
  leave
  mission
  excused_absence
  early_leave
  missing_punch
}

enum LeaveType {
  annual
  casual
  sick
  unpaid
  mission
  permission
  excused_absence
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum DeductionType {
  late
  absence
  early_leave
  permission
  unauthorized_exit
  penalty
  advance
  admin_deduction
  other
}

enum AllowanceType {
  transport
  meal
  fixed
  incentive
  bonus
}

enum PayrollPeriodStatus {
  draft
  calculated
  approved
  closed
}

/// Document slots on the employee service file. The first nine mirror the
/// company's own HR-F-04 "فهرس ملف الخدمة" checklist and are what
/// REQUIRED_EMPLOYEE_DOCUMENT_TYPES (src/lib/types.ts) counts as missing;
/// the rest are optional extras that can be uploaded but are never demanded.
enum EmployeeDocumentType {
  national_id_photo // بطاقة الرقم القومي
  birth_certificate // شهادة الميلاد
  criminal_record // صحيفة الحالة الجنائية (الفيش الجنائي)
  health_certificate // شهادة صحية / كشف طبي
  work_contract // عقد العمل / إقرار استلام عمل
  social_insurance_form // استمارة التأمينات الاجتماعية
  job_application_form // استمارة طلب توظيف / التحاق بوظيفة
  qualification_certificate // المؤهل الدراسي
  personal_photo // صورة شخصية
  military_certificate // شهادة الموقف من التجنيد (ذكور فقط)
  work_experience_certificate // كعب عمل
  cv // السيرة الذاتية
  driving_license // رخصة القيادة
  company_policy // لائحة داخلية / سياسات الشركة
  other // أخرى
}


// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  /// Granular page permissions for non-admin "اداري" (hr/supervisor) accounts —
  /// admin always has full access regardless of this list; employee ignores it.
  /// Empty until an admin grants access via /permissions.
  permissions  Json        @default("[]")
  /// "All permissions": this اداري may add/edit/approve without waiting for an admin
  /// (each such action is still logged on /change-requests as a direct execution).
  /// Deletes always still need approval. Ignored for admin/employee.
  directEdit   Boolean     @default(false)
  active       Boolean     @default(true)
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  /// Legacy single-department link — superseded by `departmentIds` for scoping
  /// (kept only so existing rows don't lose the FK; new code reads/writes
  /// `departmentIds` instead).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  /// Free multi-department scope for hr/supervisor "اداري" accounts — empty
  /// array means company-wide (all departments), like the old hr role.
  departmentIds Json       @default("[]")
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assistantMessages AssistantMessage[]

  @@index([employeeId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Department {
  id        String    @id @default(cuid())
  name      String
  /// The department head — a real employee, so a rename shows up here on its own.
  /// Cleared (not blocked) if that employee is ever hard-deleted.
  managerId String?
  manager   Employee? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employees Employee[] @relation("DepartmentMembers")
  users     User[]

  @@index([managerId])
}

/// Per-department atomic counter backing Employee.employeeNumber generation
/// (see generateEmployeeNumber in src/lib/employee-number.ts). `code` is the
/// short department code (e.g. "ACC"), not the Department id.
model DepartmentNumberSequence {
  code      String @id
  /// The last sequence value issued for this code (not the next one to hand
  /// out) — see generateEmployeeNumber in src/lib/employee-number.ts.
  lastValue Int    @default(0)
}

model Shift {
  id                 String    @id @default(cuid())
  name               String
  startTime          String // "08:00"
  endTime            String // "16:00" (may cross midnight)
  gracePeriodMinutes Int       @default(10)
  workDays           Json // number[] 0=Sunday..6=Saturday
  allowOvertime      Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employees       Employee[]
  dailyAttendance DailyAttendance[]
}

model Employee {
  id                    String         @id @default(cuid())
  /// Human-facing employee number, "<DEPT_CODE>-<seq>" (e.g. ACC-001). Auto-generated
  /// on creation from DepartmentNumberSequence — distinct from `id` (internal PK) and
  /// from `biometricDeviceUserId` (the fingerprint device's own user id). Never edited.
  employeeNumber        String         @unique
  name                  String
  departmentId          String
  department            Department     @relation("DepartmentMembers", fields: [departmentId], references: [id])
  jobTitle              String
  hireDate              DateTime       @db.Date
  shiftId               String
  shift                 Shift          @relation(fields: [shiftId], references: [id])
  /// The pay type whose rules (multipliers, day divisor, Thursday rule…) apply to this employee. Null on rows
  /// saved before pay types existed: those resolve by `salaryType` to the built-in type with that code.
  payTypeId             String?
  payType               PayType?       @relation(fields: [payTypeId], references: [id])
  /// A fixed work schedule, or custom times below (custom wins when set). Neither: the pay type's own times,
  /// and failing those the shift.
  workScheduleId        String?
  workSchedule          WorkSchedule?  @relation(fields: [workScheduleId], references: [id])
  customWorkStart       String? // "08:00"
  customWorkEnd         String? // "18:30"
  customOvertimeStart   String? // null = from the work end
  /// Mirrors the pay type's basis ("monthly" = full salary, "daily" = paid days), kept for older code paths.
  salaryType            SalaryType     @default(monthly)
  basicSalary           Int            // monthly: the full salary. daily: fallback only — dailyRate is authoritative
  dailyRate             Int?           // required when salaryType = daily — pay for one worked day
  dailyWorkingHours     Float          @default(8) // this employee's contracted daily hours (for hourly rate)
  allowancesTotal       Int            @default(0) // quick-display fixed monthly allowances; itemised in Allowance[]
  /// The linked ZKTeco device user's own "User ID" (see BiometricDeviceSettings) -
  /// null when the employee hasn't been linked to a device user yet. Linking/
  /// unlinking happens from /biometric-device, not the employee form (see
  /// linkDeviceUserAction in src/lib/actions/biometric-device.ts). Unique so one
  /// device user can never be linked to two employees at once.
  biometricDeviceUserId String?        @unique
  /// When that link was made - absences are only recorded from this day on, since before it the person
  /// had no way to punch. Null for links made before this was tracked.
  biometricLinkedAt     DateTime?
  status                EmployeeStatus @default(active)
  phone                 String?
  address               String?         @db.Text
  qualification         String?
  militaryStatus        MilitaryStatus?
  nationalId            String?         @unique // الرقم القومي — enforced required by the form; nullable for the migration of existing rows
  /// This employee's own list of required document types (a JSON array of
  /// EmployeeDocumentType). null = the company default (REQUIRED_EMPLOYEE_DOCUMENT_TYPES) —
  /// only set once someone moves a document between "required" and "additional".
  requiredDocuments     Json?
  avatarColor           String?
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  attendanceLogs  AttendanceLog[]
  dailyAttendance DailyAttendance[]
  leaves          Leave[]
  overtime        Overtime[]
  deductions      Deduction[]
  allowances      Allowance[]
  payrollRecords  PayrollRecord[]
  documents       EmployeeDocument[]
  acknowledgments EmployeeAcknowledgment[]
  users           User[]
  managedDepartments Department[] @relation("DepartmentManager")

  @@index([departmentId])
  @@index([shiftId])
  @@index([status])
  @@index([payTypeId])
  @@index([workScheduleId])
}

/// A pay type (نوع الأجر) and every rule used to calculate its pay. Nothing about pay is fixed in code: each
/// number here is edited from /settings, and a new type can be added with rules of its own. Soft-deleted
/// (deletedAt) so employees and past calculations that used a type keep resolving it.
model PayType {
  id                         String     @id @default(cuid())
  /// "monthly" / "daily" for the two built-in types that pre-existing employees resolve to by salaryType.
  code                       String?    @unique
  name                       String
  /// How the base pay is formed: the full salary ("monthly") or paid days × day rate ("daily").
  basis                      SalaryType @default(monthly)
  /// A day's pay = salary / this (30 for salaried, 26 for daily, …).
  dayDivisor                 Float      @default(30)
  /// Hours a day's pay covers, for the hourly rate. Null = from the schedule (work start → overtime start).
  hoursPerDay                Float?
  /// Default times for employees of this type (used when an employee has no schedule or custom times).
  workStart                  String?
  workEnd                    String?
  overtimeStart              String?
  /// Minutes of lateness tolerated before any of it counts.
  graceMinutes               Float      @default(0)
  /// Each late minute costs this many minutes of pay.
  lateMultiplier             Float      @default(1.5)
  /// Each counted overtime hour pays this many hours.
  overtimeMultiplier         Float      @default(1.5)
  /// Overtime shorter than this is not counted at all.
  overtimeMinimumMinutes     Int        @default(60)
  /// Counted overtime is taken in whole steps of this many minutes (60 = whole hours, 30 = half hours).
  overtimeStepMinutes        Int        @default(30)
  /// System-calculated overtime is approved straight away; off = it waits for approval.
  overtimeAutoApprove        Boolean    @default(true)
  /// Each hour missed on an approved permission for the rest of the day costs this many hours.
  permissionMultiplier       Float      @default(1)
  /// Each hour missed by leaving without permission costs this many hours.
  unauthorizedExitMultiplier Float      @default(1.5)
  /// Each hour worked on the weekly day off pays this many hours.
  fridayMultiplier           Float      @default(2)
  /// Each hour worked on a public holiday pays this many hours.
  holidayMultiplier          Float      @default(2)
  /// Thursday rule: the day ends at thursdayWorkEnd, and time worked from then until the usual overtime start
  /// pays thursdayExtraMultiplier (normal time), not overtime.
  thursdayRuleEnabled        Boolean    @default(false)
  thursdayWorkEnd            String?
  thursdayExtraMultiplier    Float      @default(1)
  /// Days of pay a day off costs: on approved leave asked for leaveNoticeHours ahead, and otherwise.
  permittedAbsenceDays       Float      @default(1)
  unpermittedAbsenceDays     Float      @default(2)
  leaveNoticeHours           Int        @default(48)
  active                     Boolean    @default(true)
  sortOrder                  Int        @default(0)
  deletedAt                  DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  employees Employee[]
}

/// A fixed work schedule employees can be put on (08:00 → 16:30 …). Managed from /settings; soft-deleted so
/// employees who were on one keep their times.
model WorkSchedule {
  id            String    @id @default(cuid())
  name          String
  startTime     String
  endTime       String
  /// Null = overtime starts at the end time.
  overtimeStart String?
  /// Offered when adding or editing an employee.
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employees Employee[]
}

// ---------------------------------------------------------------------------
// Biometric devices & raw punches
// ---------------------------------------------------------------------------

model Device {
  id         String   @id @default(cuid())
  name       String
  location   String?
  apiKeyHash String? // set for real ZKTeco devices posting to /api/punch
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  logs AttendanceLog[]
}

/// Immutable raw biometric record. Never edited or deleted (spec §46).
model AttendanceLog {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  deviceId     String?
  device       Device?     @relation(fields: [deviceId], references: [id])
  deviceUserId String? // raw user id reported by the device, before it is mapped to an employee
  timestamp    DateTime
  punchType    PunchType
  source       PunchSource @default(biometric)
  rawPayload   Json? // verbatim device payload, for audit / re-processing
  receivedAt   DateTime    @default(now())

  @@index([employeeId, timestamp])
  @@index([deviceId])
  @@index([deviceUserId, timestamp])
}

// ---------------------------------------------------------------------------
// Computed attendance (correctable)
// ---------------------------------------------------------------------------

model DailyAttendance {
  id                    String           @id @default(cuid())
  employeeId            String
  employee              Employee         @relation(fields: [employeeId], references: [id])
  date                  DateTime         @db.Date
  shiftId               String
  shift                 Shift            @relation(fields: [shiftId], references: [id])
  scheduledStart        DateTime
  scheduledEnd          DateTime
  actualIn              DateTime?
  actualOut             DateTime?
  lateMinutes           Int              @default(0)
  deductibleLateMinutes Int              @default(0)
  earlyLeaveMinutes     Int              @default(0)
  workedMinutes         Int              @default(0)
  overtimeMinutes       Int              @default(0)
  status                AttendanceStatus
  correctionReason      String?
  correctedBy           String?
  correctedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([employeeId, date]) // one computed row per employee per day — supports daily upsert/rollover
  @@index([date, status])
}

// ---------------------------------------------------------------------------
// Requests & adjustments
// ---------------------------------------------------------------------------

model Leave {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  type       LeaveType
  from       DateTime      @db.Date
  to         DateTime      @db.Date
  reason     String        @db.Text
  status     RequestStatus @default(pending)
  approvedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Overtime {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  date       DateTime      @db.Date
  hours      Float
  hourlyRate Int
  amount     Int           @default(0)
  status     RequestStatus @default(pending)
  approvedBy String?
  notes      String?       @db.Text
  /// What the addition is: "overtime", "friday" (work on the weekly day off), "holiday", "thursday_extra"
  /// (Thursday time after the short day, at normal rate). Entries made by hand are "overtime".
  kind           String    @default("overtime")
  /// The pay-hours multiplier the system applied (1.5 …). Null on entries made by hand.
  multiplier     Float?
  /// Posted by the system from attendance; systemKey "<employeeId>|<yyyy-MM-dd>|<kind>" keeps it to one.
  autoGenerated  Boolean   @default(false)
  systemKey      String?   @unique
  /// What the system calculated, kept when someone edits it.
  originalHours  Float?
  originalAmount Int?
  editedBy       String?
  editedAt       DateTime?
  /// A system entry someone removed: kept (not deleted) so the system doesn't post it again.
  voidedBy       String?
  voidedAt       DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Deduction {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  type          DeductionType
  amount        Int
  date          DateTime      @db.Date
  reason        String        @db.Text
  notes         String?       @db.Text
  autoGenerated Boolean       @default(false)
  /// For deductions the system posts from attendance: "<employeeId>|<yyyy-MM-dd>|<type>", so each day's
  /// deduction is posted once and kept in step with that day. Null for deductions entered by a person.
  systemKey     String?       @unique
  /// Set when someone edits a system deduction by hand: from then on the system leaves it as they set it.
  /// What the system calculated, kept when someone edits the amount.
  originalAmount Int?
  editedBy      String?
  editedAt      DateTime?
  /// A system deduction someone removed. Kept (not deleted) so the system doesn't post it again.
  voidedBy      String?
  voidedAt      DateTime?
  createdAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([date])
}

model Allowance {
  id             String        @id @default(cuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  type           AllowanceType
  amount         Int
  monthly        Boolean       @default(true) // recurring every month (transport / meal / fixed / incentive)
  effectiveYear  Int? // set when monthly = false — the one period this applies to (a bonus)
  effectiveMonth Int? // 1-12
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  @@index([employeeId])
  @@index([effectiveYear, effectiveMonth])
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

model PayrollPeriod {
  id           String              @id @default(cuid())
  label        String // "أغسطس 2026"
  year         Int
  month        Int // 1-12
  status       PayrollPeriodStatus @default(draft)
  calculatedAt DateTime?
  approvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime            @default(now())

  records PayrollRecord[]

  @@unique([year, month])
}

model PayrollRecord {
  id                  String        @id @default(cuid())
  periodId            String
  period              PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id])
  basicSalary         Int
  allowances          Int
  overtimeAmount      Int
  incentives          Int
  bonuses             Int
  grossSalary         Int
  lateDeduction       Int
  absenceDeduction    Int
  earlyLeaveDeduction Int
  penalties           Int
  advances            Int
  otherDeductions     Int
  totalDeductions     Int
  netSalary           Int
  paidDaysCount       Int?          // daily employees only — worked days paid this period
  dailyRateApplied    Int?          // daily employees only — day rate at calculation time (historical record)
  createdAt           DateTime      @default(now())

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// HR documents
// ---------------------------------------------------------------------------

/// Scanned files on an employee's service file. A type can hold several files —
/// an ID card is a front and a back, a qualification can run to several pages —
/// so uploads append rather than replace, and deletes address a single row by id.
model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       EmployeeDocumentType
  // Private on-disk path, relative to DOCUMENT_STORAGE_ROOT (src/lib/documents.ts)
  // — NOT a public URL. Never sent to the client as-is; serialize.ts derives
  // the scope-checked API URL instead. Resolved server-side only, by the
  // GET handler on the same route that accepts the upload.
  fileUrl    String
  fileName   String?
  mimeType   String?
  uploadedBy String? // display name of the user who uploaded it
  uploadedAt DateTime             @default(now())

  @@index([employeeId])
  @@index([employeeId, type])
}

/// A signed acknowledgment scan. Three fixed slots (see STANDARD_ACKNOWLEDGMENTS
/// in src/lib/acknowledgments.ts) plus any number of custom-named slots
/// (`key` = "custom-<cuid>"). One file per key per employee — a re-upload
/// replaces it, exactly like EmployeeDocument.
model EmployeeAcknowledgment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  key        String // "employment_terms" | "custody_receipt" | "confidentiality" | "custom-<cuid>"
  label      String // display name (fixed for the standard three, user-typed for custom)
  fileUrl    String // private storage key — see the comment on EmployeeDocument.fileUrl
  fileName   String?
  mimeType   String?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@unique([employeeId, key])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

/// One turn of a user's running conversation with the virtual assistant. Each user has a single
/// ongoing thread (ordered by createdAt). Only what was asked and answered is stored; the data the
/// assistant looked up to answer is read fresh every time and never kept here.
model AssistantMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit & settings
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id        String   @id @default(cuid())
  userName  String
  action    String
  module    String
  oldValue  String   @db.Text
  newValue  String   @db.Text
  reason    String?  @db.Text
  timestamp DateTime @default(now())

  @@index([timestamp])
}

/// A write an "اداري" (non-admin) account asked to make — held pending until
/// an admin approves (then it's actually applied, attributed to the original
/// requester in AuditLogEntry) or rejects it (never applied). `payload` is the
/// already-validated data the write needs; `actionKey` identifies which
/// module/apply-function should run it (see src/lib/change-requests.ts).
model ChangeRequest {
  id            String              @id @default(cuid())
  requestedById String
  requestedBy   String // display name at request time
  module        String // localized module label, e.g. "الموظفين"
  actionLabel   String // localized action label, e.g. "إضافة موظف"
  actionKey     String // e.g. "employees.create" — dispatch key for the apply function
  targetId      String? // record being updated/deleted, if any
  summary       String              @db.Text // human-readable old → new, for the review screen
  payload       Json // validated data to re-run the write on approval
  status        ChangeRequestStatus @default(pending)
  /// true = executed immediately by a `directEdit` user (recorded here for the admin, never pending)
  direct        Boolean             @default(false)
  reviewedBy    String?
  reviewNote    String?             @db.Text
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  @@index([status])
  @@index([requestedById])
}

/// Single-row settings tables (id is always "singleton").
model CompanySettings {
  id          String @id @default("singleton")
  companyName String
  logoUrl     String
  address     String
  phone       String
}

model AttendanceSettings {
  id                           String @id @default("singleton")
  defaultGracePeriodMinutes    Int    @default(10)
  lateDeductionPerMinute       Int    @default(5)
  earlyLeaveDeductionPerMinute Int    @default(5)
  absenceDeductionDays         Int    @default(1)
  /// The weekly day(s) off, comma-separated day numbers (0 = Sunday … 5 = Friday).
  weeklyOffDays                String @default("5")
}

model PayrollSettings {
  id                       String @id @default("singleton")
  overtimeHourlyMultiplier Float  @default(1.5)
  workingDaysPerMonth      Int    @default(26)
  workingHoursPerDay       Int    @default(8)
  /// The pay month runs from this day of the month before up to the day before it in the named month.
  payPeriodStartDay        Int    @default(26)
}

/// Connection settings for the ZKTeco biometric device managed from /biometric-device.
/// Distinct from PUNCH_API_KEY (which authenticates the device's own push-protocol
/// POSTs to /api/punch) — this is the app acting as a client of the device's SDK port.
model BiometricDeviceSettings {
  id           String   @id @default("singleton")
  ip           String
  port         Int      @default(4370)
  commPassword Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// A public holiday (or any factory-wide day off besides Friday), one row per holiday, which may span
/// several days (e.g. Eid). Nobody is recorded absent on these days; whoever works still punches as usual.
model Holiday {
  id        String   @id @default(cuid())
  name      String
  from      DateTime @db.Date
  to        DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([from, to])
}
