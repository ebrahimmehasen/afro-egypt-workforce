# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# MySQL connection
# ---------------------------------------------------------------------------
# On the server (or your local MySQL), create the database and a user:
#
#   CREATE DATABASE afro_egypt_workforce CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'afro'@'localhost' IDENTIFIED BY 'strong-password';
#   GRANT ALL PRIVILEGES ON afro_egypt_workforce.* TO 'afro'@'localhost';
#   FLUSH PRIVILEGES;
#
# Then point DATABASE_URL at it:
DATABASE_URL="mysql://afro:strong-password@localhost:3306/afro_egypt_workforce"

# First-time / deploy setup:
#   npm install
#   npx prisma migrate deploy      # (or: npm run db:migrate  for local dev)
#   npm run db:seed                # loads the demo data + login accounts

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# Session cookie signing key — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-string"

# Shared secret biometric devices (ZKTeco) send in the X-Punch-Key header
# when POSTing to /api/punch
PUNCH_API_KEY="change-me"

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# false (default / production): "today" is the real clock, no demo badges,
#   no demo logins on the sign-in page, /demo tour disabled.
#   Seed with:  npm run db:seed:prod   (departments + shifts + one admin only)
#
# true (for showing the system off): "today" is frozen at 2026-08-21, demo
#   badges + guided tour shown, demo logins listed on the sign-in page.
#   Seed with:  npm run db:seed        (50 fake employees + 13 days of history)
NEXT_PUBLIC_DEMO_MODE="false"
