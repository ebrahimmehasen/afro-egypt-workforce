# Copy to .env and fill in. Never commit .env.

# MySQL connection. On your server, create the database and a dedicated user:
#   CREATE DATABASE afro_egypt_workforce CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'afro'@'%' IDENTIFIED BY 'strong-password';
#   GRANT ALL PRIVILEGES ON afro_egypt_workforce.* TO 'afro'@'%';
DATABASE_URL="mysql://afro:strong-password@localhost:3306/afro_egypt_workforce"

# Session cookie signing key — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-string"

# Shared secret ZKTeco / biometric devices send in the X-Punch-Key header to POST /api/punch
PUNCH_API_KEY="change-me"
