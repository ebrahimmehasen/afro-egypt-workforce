# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# MySQL connection
# ---------------------------------------------------------------------------
# On the server (or your local MySQL), create the database and a user:
#
#   CREATE DATABASE afro_egypt_workforce CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'afro'@'localhost' IDENTIFIED BY 'strong-password';
#   GRANT ALL PRIVILEGES ON afro_egypt_workforce.* TO 'afro'@'localhost';
#   FLUSH PRIVILEGES;
#
DATABASE_URL="mysql://afro:strong-password@localhost:3306/afro_egypt_workforce"

# ---------------------------------------------------------------------------
# App secrets  (REQUIRED — the app refuses to start without SESSION_SECRET)
# ---------------------------------------------------------------------------
# Session cookie signing key. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32+-char-string"

# Shared secret biometric devices (ZKTeco) send in the X-Punch-Key header
# when POSTing to /api/punch
PUNCH_API_KEY="change-me"

# ---------------------------------------------------------------------------
# First-time / deploy setup
# ---------------------------------------------------------------------------
#   npm install
#   npx prisma migrate deploy
#
#   # then ONE of:
#   ADMIN_EMAIL=you@company.com ADMIN_PASSWORD='...' npm run db:seed
#       -> production seed: 6 departments, 3 shifts, settings, one admin user.
#          No employees / attendance / payroll. Start entering real data.
#
#   npm run db:seed:sample
#       -> sample org to explore the app: 50 fictional employees, ~13 days of
#          history ending today, 4 logins (password: demo123). NOT for production.
